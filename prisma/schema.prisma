generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserRole {\n  CREATOR\n  ADMIN\n  CUSTOMER\n}
enum ProductType {\n  DIGITAL\n  COURSE\n  MEMBERSHIP\n}
enum ProductStatus {\n  DRAFT\n  PUBLISHED\n  ARCHIVED\n}
enum OrderStatus {\n  PENDING\n  PAID\n  FAILED\n  REFUNDED\n}
enum LessonType {\n  VIDEO\n  TEXT\n  FILE\n}
model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  image String?
  role UserRole @default(CREATOR)
  profile CreatorProfile?
  products Product[]
  orders Order[]
  sessions Session[]
  loginCodes LoginCode[]
  enrollments Enrollment[]
  lessonProgress LessonProgress[]
  leads Lead[]
  emailCampaigns EmailCampaign[]
  emailAutomations EmailAutomation[]
  bookingSlots BookingSlot[]
  bookings Booking[]
  ownedMemberships Membership[] @relation("MembershipCreator")
  analyticsEvents AnalyticsEvent[]
  communityConnections CommunityConnection[]
  joinedMemberships Membership[] @relation("MembershipMember")
  events Event[]
  subscriptions Subscription[]
  emailUnsubscribes EmailUnsubscribe[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Session { id String @id @default(cuid())
token String @unique
userId String
expiresAt DateTime
user User @relation(fields:[userId],references:[id],onDelete:Cascade)
createdAt DateTime @default(now())
@@index([userId])
@@index([expiresAt]) }
model LoginCode { id String @id @default(cuid())
userId String
code String
attempts Int @default(0)
expiresAt DateTime
user User @relation(fields:[userId],references:[id],onDelete:Cascade)
createdAt DateTime @default(now())
@@index([userId,code])
@@index([expiresAt]) }
model CreatorProfile { id String @id @default(cuid())
userId String @unique
username String @unique
displayName String
bio String?
avatarUrl String?
theme String @default("minimal")
published Boolean @default(false)
user User @relation(fields:[userId],references:[id],onDelete:Cascade)
links ProfileLink[]
products Product[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt }
model ProfileLink { id String @id @default(cuid())
profileId String
title String
url String
position Int @default(0)
enabled Boolean @default(true)
profile CreatorProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt }
model Product {
  id String @id @default(cuid())
creatorId String
profileId String
type ProductType @default(DIGITAL)
status ProductStatus @default(DRAFT)
name String
slug String @unique
description String?
price Int @default(0)
currency String @default("INR")
fileUrl String?
fileKey String?
coverUrl String?
  creator User @relation(fields:[creatorId],references:[id],onDelete:Cascade)
profile CreatorProfile @relation(fields:[profileId],references:[id],onDelete:Cascade)
orders Order[]
course Course?
enrollments Enrollment[]
  memberships Membership[]
  createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([profileId,status])
}
model Order {
  id String @id @default(cuid())
productId String
creatorId String
buyerEmail String
amount Int
currency String @default("INR")
status OrderStatus @default(PENDING)
provider String?
providerId String?
providerPaymentId String?
  downloadToken String? @unique
  product Product @relation(fields:[productId],references:[id])
creator User @relation(fields:[creatorId],references:[id])
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([buyerEmail])
@@index([providerId])
}
model Course { id String @id @default(cuid())
productId String @unique
title String
description String?
product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
modules CourseModule[]
enrollments Enrollment[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt }
model CourseModule { id String @id @default(cuid())
courseId String
title String
position Int @default(0)
course Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
lessons Lesson[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([courseId,position]) }
model Lesson { id String @id @default(cuid())
moduleId String
title String
type LessonType @default(VIDEO)
contentUrl String?
body String?
position Int @default(0)
module CourseModule @relation(fields:[moduleId],references:[id],onDelete:Cascade)
progress LessonProgress[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
@@index([moduleId,position]) }
model Enrollment { id String @id @default(cuid())
courseId String
productId String
userId String
course Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
user User @relation(fields:[userId],references:[id],onDelete:Cascade)
createdAt DateTime @default(now())
@@unique([courseId,userId])
@@index([userId]) }
model Lead {
  id String @id @default(cuid())
  creatorId String
  email String
  name String?
  source String?
  leadMagnetId String?
  creator User @relation(fields:[creatorId],references:[id],onDelete:Cascade)
  leadMagnet LeadMagnet? @relation(fields:[leadMagnetId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([creatorId,email])
  @@index([creatorId,createdAt])
}
model LeadMagnet {
  id String @id @default(cuid())
  creatorId String
  name String
  description String?
  fileUrl String?
  fileKey String?
  slug String @unique
  published Boolean @default(false)
  creator User @relation(fields:[creatorId],references:[id],onDelete:Cascade)
  leads Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([creatorId,published])
}
model BookingSlot {
  id String @id @default(cuid())
  creatorId String
  startAt DateTime
  endAt DateTime
  price Int @default(0)
  currency String @default("INR")
  available Boolean @default(true)
  meetingUrl String?
  creator User @relation(fields:[creatorId],references:[id],onDelete:Cascade)
  booking Booking?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([creatorId,startAt])
}
model Booking {
  id String @id @default(cuid())
  creatorId String
  slotId String @unique
  customerEmail String
  customerName String?
  note String?
  amount Int @default(0)
  currency String @default("INR")
  status String @default("PENDING")
  provider String?
  providerOrderId String?
  providerPaymentId String?
  manageToken String? @unique
  reminder24SentAt DateTime?
  reminder1SentAt DateTime?
  creator User @relation(fields:[creatorId],references:[id],onDelete:Cascade)
  slot BookingSlot @relation(fields:[slotId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([creatorId,status])
  @@index([customerEmail])
}
model Membership {
  id String @id @default(cuid())
  creatorId String
  productId String
  memberUserId String
  status String @default("ACTIVE")
  startedAt DateTime @default(now())
  expiresAt DateTime?
  creator User @relation("MembershipCreator",fields:[creatorId],references:[id],onDelete:Cascade)
  product Product @relation(fields:[productId],references:[id],onDelete:Cascade)
  member User @relation("MembershipMember",fields:[memberUserId],references:[id],onDelete:Cascade)
  @@unique([productId,memberUserId])
  @@index([creatorId,status])
  @@index([memberUserId,status])
}
model LessonProgress { id String @id @default(cuid())
lessonId String
userId String
completed Boolean @default(false)
progress Int @default(0)
lesson Lesson @relation(fields:[lessonId],references:[id],onDelete:Cascade)
user User @relation(fields:[userId],references:[id],onDelete:Cascade)
updatedAt DateTime @updatedAt
createdAt DateTime @default(now())
@@unique([lessonId,userId])
@@index([userId]) }

model Event {
  id String @id @default(cuid())
  creatorId String
  name String
  slug String @unique
  description String?
  startsAt DateTime
  endsAt DateTime?
  meetingUrl String?
  price Int @default(0)
  currency String @default("INR")
  capacity Int?
  published Boolean @default(false)
  creator User @relation(fields:[creatorId],references:[id],onDelete:Cascade)
  registrations EventRegistration[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([creatorId,startsAt])
}
model EventRegistration {
  id String @id @default(cuid())
  eventId String
  email String
  name String?
  status String @default("REGISTERED")
  provider String?
  providerOrderId String?
  providerPaymentId String?
  createdAt DateTime @default(now())
  event Event @relation(fields:[eventId],references:[id],onDelete:Cascade)
  @@unique([eventId,email])
  @@index([email])
}
model SaaSPlan {
  id String @id @default(cuid())
  name String @unique
  monthlyPrice Int @default(0)
  yearlyPrice Int @default(0)
  razorpayMonthlyPlanId String?
  razorpayYearlyPlanId String?
  active Boolean @default(true)
  subscriptions Subscription[]
}
model Subscription {
  id String @id @default(cuid())
  userId String
  planId String
  provider String
  providerSubscriptionId String?
  billingInterval String @default("MONTHLY")
  status String @default("ACTIVE")
  currentPeriodEnd DateTime?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  plan SaaSPlan @relation(fields:[planId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,status])
  @@index([providerSubscriptionId])
  @@unique([userId,planId])
}
model CommunityConnection {
  id String @id @default(cuid())
  creatorId String
  provider String
  externalId String?
  accessToken String?
  enabled Boolean @default(true)
  creator User @relation(fields:[creatorId],references:[id],onDelete:Cascade)
  @@unique([creatorId,provider])
}

model AnalyticsEvent {
  id String @id @default(cuid())
  creatorId String
  type String
  path String?
  referrer String?
  sessionId String?
  metadata String?
  createdAt DateTime @default(now())
  creator User @relation(fields:[creatorId],references:[id],onDelete:Cascade)
  @@index([creatorId,createdAt])
  @@index([creatorId,type,createdAt])
  @@index([creatorId,path,createdAt])
}

model EmailCampaign {
  id String @id @default(cuid())
  creatorId String
  name String
  subject String
  body String
  segment String @default("ALL")
  status String @default("DRAFT")
  sentAt DateTime?
  deliveries EmailDelivery[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator User @relation(fields:[creatorId],references:[id],onDelete:Cascade)
  @@index([creatorId,status])
  @@index([creatorId,createdAt])
}

model EmailAutomation {
  id String @id @default(cuid())
  creatorId String
  name String
  trigger String
  subject String
  body String
  enabled Boolean @default(true)
  steps EmailAutomationStep[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator User @relation(fields:[creatorId],references:[id],onDelete:Cascade)
  @@index([creatorId,trigger,enabled])
}

model EmailAutomationStep {
  id String @id @default(cuid())
  automationId String
  position Int @default(0)
  delayHours Int @default(0)
  subject String
  body String
  automation EmailAutomation @relation(fields:[automationId],references:[id],onDelete:Cascade)
  @@index([automationId,position])
}

model EmailDelivery {
  id String @id @default(cuid())
  campaignId String?
  recipientEmail String
  recipientName String?
  subject String
  status String @default("SENT")
  providerId String?
  automationId String?
  stepId String?
  error String?
  sentAt DateTime @default(now())
  campaign EmailCampaign? @relation(fields:[campaignId],references:[id],onDelete:SetNull)
  @@index([campaignId,status])
  @@index([recipientEmail,sentAt])
}

model EmailUnsubscribe {
  id String @id @default(cuid())
  creatorId String
  email String
  createdAt DateTime @default(now())
  creator User @relation(fields:[creatorId],references:[id],onDelete:Cascade)
  @@unique([creatorId,email])
  @@index([email])
}

model WebhookEvent {
  id String @id @default(cuid())
  provider String
  eventId String
  eventType String
  status String @default("PROCESSING")
  payloadHash String
  processedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([provider,eventId])
  @@index([provider,eventType,createdAt])
}
